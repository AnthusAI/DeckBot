{
  "name": "deckbot-electron",
  "version": "1.0.0",
  "description": "DeckBot Desktop Application - Vibe-Coded Presentation Assistant",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "build:frontend": "cd frontend && npm run build",
    "build:python": "node build/build-python.js",
    "build:nodejs": "node build/build-nodejs.js",
    "build:all": "npm run build:frontend && npm run build:python && npm run build:nodejs",
    "build:electron:mac": "electron-builder --mac",
    "build:electron:win": "electron-builder --win",
    "dist:mac": "npm run build:all && npm run build:electron:mac",
    "dist:win": "npm run build:all && npm run build:electron:win",
    "postinstall": "cd frontend && npm install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "presentation",
    "slides",
    "marp",
    "ai",
    "gemini",
    "electron"
  ],
  "author": "Ryan Porter",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "fs-extra": "^11.2.0"
  },
  "build": {
    "appId": "com.anthusai.deckbot",
    "productName": "DeckBot",
    "directories": {
      "output": "dist",
      "buildResources": "electron/resources"
    },
    "files": [
      "electron/**/*",
      "src/deckbot/static/dist/**/*",
      "!electron/resources/python/**/*",
      "!electron/resources/nodejs/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/resources/python",
        "to": "python"
      },
      {
        "from": "electron/resources/nodejs",
        "to": "nodejs"
      },
      {
        "from": "templates",
        "to": "templates"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/deckbot-logo.png",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "DeckBot Installer",
      "icon": "assets/deckbot-logo.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/deckbot-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    }
  }
}
